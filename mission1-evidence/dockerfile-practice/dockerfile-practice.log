]3008;start=1c4c812c-0e32-4b68-a9a3-2e368edc22a4;machineid=eb4980fbf6c343c6810441c8c3bcef91;user=user;hostname=4F-92;bootid=ed15b65e-c426-4a2f-964c-9afa8c7c9a80;pid=00000000000000013696;type=command;cwd=/home/user/mission1-evidence/dockerfile-practice\# nginx 공식 이미지를 베이스로 사용
FROM nginx:alpine

# 메타데이터 추가
LABEL maintainer="user@codyssey"
LABEL description="Mission1 Dockerfile 실습용 커스텀 nginx"

# 작성한 HTML을 nginx 기본 폴더에 복사
COPY index.html /usr/share/nginx/html/index.html

# 80번 포트 사용 명시 (문서화 목적)
EXPOSE 80
